# Copy this file to .env and keep the resulting file private.
DISCORD_TOKEN=replace-me
HUGH_INCIDENT_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me
# Required only while [rotector] is enabled in config.toml.
HUGH_ROTECTOR_API_KEY=replace-me

# Optional runtime logging settings.
RUST_LOG=hugh=info
HUGH_LOG_FORMAT=json
